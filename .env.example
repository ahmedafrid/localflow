# Optional. Copy to .env (or paste the key in the LocalFlow window instead).
# Without a key, LocalFlow pastes exactly what Whisper heard, fully offline.
OPENROUTER_API_KEY=
FLOW_MODEL=google/gemini-3.5-flash-lite
# FLOW_MODE=dev        # dev | everyday
# FLOW_LANG=en         # empty = auto-detect
# FLOW_KEEP_DAYS=0     # auto-delete history after N days, 0 = keep
# FLOW_HOTKEY=ctrl_r   # Windows/Linux only: ctrl_r, alt_r, f9, ...
